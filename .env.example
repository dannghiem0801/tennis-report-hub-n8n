# =============================================================================
# Tennis Report Hub — environment variables
# =============================================================================
#
# Copy this file to `.env.local` and fill in the values you want pre-loaded
# at startup. The app will pick them up automatically on the next `npm run dev`
# or `npm run build` — no need to also paste them into the Settings UI.
#
#   cp .env.example .env.local
#
# Rules of thumb:
#   - All variables exposed to the browser MUST be prefixed with `VITE_`.
#     Vite refuses to expose anything else to client code, so a non-prefixed
#     key here will be silently dropped (use it only for server-side config
#     like `LLM_PROXY_URL` below).
#   - `.env.local` is git-ignored. `.env.example` is the only env file you
#     commit — keep it updated when you add a new key.
#   - Precedence at runtime: env vars WIN over localStorage on startup.
#     Whatever you set here is what the app will boot with. If you want
#     Settings UI values to stick across reloads, leave the corresponding
#     env var blank in `.env.local`.
#
# =============================================================================


# -----------------------------------------------------------------------------
# Tennis data — RapidAPI FlashScore4 (server-side only)
# -----------------------------------------------------------------------------
# Required to load match data on the dashboard. Set this in Vercel's
# Environment Variables for production; for local development set it in
# `.env.local`. It is deliberately not prefixed with `VITE_`, so it is never
# included in the browser bundle.
RAPID_API_KEY=
# Optional; defaults to flashscore4.p.rapidapi.com.
RAPID_API_HOST=flashscore4.p.rapidapi.com


# -----------------------------------------------------------------------------
# RapidAPI MCP enrichment (server-side only, disabled by default)
# -----------------------------------------------------------------------------
# In Flashscore4's RapidAPI Playground: choose your Application, click MCP, and
# copy its exact connection configuration. The routing format is application-
# specific, so do not guess it from the REST API host.
RAPID_MCP_ENABLED=false
RAPID_MCP_URL=https://mcp.rapidapi.com
# Leave blank to reuse RAPID_API_KEY above. Never use a VITE_ prefix.
RAPID_MCP_API_KEY=
# Comma-separated MCP tool names copied from a successful tools/list response.
# Keep this read-only and narrow, e.g. match_details,match_stats.
RAPID_MCP_ALLOWED_TOOLS=
# Optional JSON containing only routing headers supplied by RapidAPI's MCP
# config, e.g. {"x-rapidapi-host":"..."}. Do not add x-rapidapi-key here.
RAPID_MCP_REQUEST_HEADERS=
# Hard cap for one enrichment request. Allowed range: 1-4; default 2.
RAPID_MCP_MAX_CALLS=2


# -----------------------------------------------------------------------------
# LLM (Anthropic / OpenAI-compatible)
# -----------------------------------------------------------------------------
# Used by the report generation engine to auto-write Vietnamese match recaps.
# When VITE_LLM_ENABLED=true AND a VITE_LLM_API_KEY is set, the app will call
# the LLM on watchlist match completion using the default "prompt" template.
# Leave VITE_LLM_ENABLED=false (or blank) to fall back to prompt-only mode —
# the prompt is then saved as-is for you to paste into an LLM manually.

VITE_LLM_ENABLED=false
# "anthropic" (default) or "openai-compatible".
VITE_LLM_PROVIDER=anthropic
# For Anthropic, the spec base is https://api.minimax.io/anthropic.
# For OpenAI-compatible, use https://api.openai.com/v1 or your proxy.
VITE_LLM_BASE_URL=https://api.minimax.io/anthropic
# Bearer token (OpenAI-compatible) or x-api-key (Anthropic).
VITE_LLM_API_KEY=
# Model identifier, e.g. MiniMax-M3 for Anthropic, gpt-4o-mini for OpenAI.
VITE_LLM_MODEL=MiniMax-M3
# Sampling temperature [0, 2]. Default 0.7.
VITE_LLM_TEMPERATURE=0.7
# Max output tokens. Anthropic requires this. Default 200000.
VITE_LLM_MAX_TOKENS=200000
# Anthropic only — send thinking blocks for reasoning models. Default true.
VITE_LLM_ENABLE_THINKING=true
# Anthropic only — declare a web_search custom tool. Default true.
VITE_LLM_ENABLE_WEB_SEARCH=true


# -----------------------------------------------------------------------------
# Web search backend (used by the LLM's `web_search` tool)
# -----------------------------------------------------------------------------
# Which backend the LLM uses to verify scores / look up context.
#   "firecrawl"  — returns full markdown, ~250 free searches/month. Best for LLM.
#   "duckduckgo" — free, dev-only via Vite proxy, often rate-limited in prod.
#   "serpapi"    — 100 free searches/month, snippets only.
#   "brave"      — 2000 free queries/month, snippets only.
# VITE_LLM_SEARCH_API_KEY is required for "serpapi" and "brave", ignored otherwise.
VITE_LLM_SEARCH_PROVIDER=firecrawl
VITE_LLM_SEARCH_API_KEY=


# -----------------------------------------------------------------------------
# LLM dev proxy target (server-side only — NOT exposed to browser)
# -----------------------------------------------------------------------------
# The Vite dev server proxies browser requests from `/llm-proxy/*` to this
# upstream. Defaults to the MiniMax Anthropic-compatible spec base. Change
# if you run a different local proxy (e.g. LiteLLM, Ollama with anthropic
# adapter, or a custom gateway).
# This variable has NO `VITE_` prefix on purpose — it must NOT be shipped
# to the client. It is only read by `vite.config.ts` for the dev proxy.
# In production builds, this proxy doesn't exist; the app talks directly
# to `VITE_LLM_BASE_URL` from the browser.
LLM_PROXY_URL=https://api.minimax.io/anthropic
